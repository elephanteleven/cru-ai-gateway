# Local run only. Copy to .env and fill in. On Coolify, set these in the Coolify UI instead
# (Coolify makes the SERVICE_PASSWORD_* values itself; see docs/coolify.md).
COMPOSE_PROJECT_NAME=cru-ai-gateway
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
GW_PORT=4000

# Must start with sk-. Make one with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=
# Random strings, e.g. openssl rand -hex 24
SERVICE_PASSWORD_POSTGRES=
SERVICE_PASSWORD_UI=
# Never change after the first start (encrypts data in the DB). openssl rand -hex 32
SERVICE_PASSWORD_64_SALTKEY=
# Public URL of the gateway. Locally: http://127.0.0.1:<GW_PORT> (Coolify sets both itself)
SERVICE_URL_LITELLM=http://127.0.0.1:4000
SERVICE_URL_LITELLM_4000=http://127.0.0.1:4000
# UI_USERNAME=admin

# OpenRouter key for every model (Cru staff fill it in, never commit it): https://openrouter.ai/keys
# Set a credit limit on the key in OpenRouter.
OPENROUTER_API_KEY=
